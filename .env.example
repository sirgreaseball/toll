# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Gemini API (free tier): aistudio.google.com > API keys
GEMINI_API_KEY=

# Firebase service account key as one line of JSON:
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Demo inbox until Firebase Auth lands in M2
DEMO_HANDLE=dhruv
INBOX_KEY=
